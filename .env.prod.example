# ==================================================================
# PROD TEMPLATE — root /.env (SADECE compose okur)
# ==================================================================
# Prod'da postgres ve minio container yok. Backend external Postgres'e
# `apps/backend/.env`'deki DATABASE_URL ile bağlanır. Buradaki değerler
# yalnızca compose substitution + nginx + watchdog için.
#
# Tam kurulum (sunucuda):
#   cp .env.prod.example .env
#   cp apps/backend/.env.prod.example   apps/backend/.env
#   cp apps/frontend/.env.example  apps/frontend/.env.local
#   cp apps/admin/.env.example     apps/admin/.env
#   docker compose up -d --build
# ==================================================================

# ---------- Compose ----------
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---------- Domain & TLS (nginx + certbot) ----------
DOMAIN=toptanbudur.com
LETSENCRYPT_EMAIL=info@toptanbudur.com
LETSENCRYPT_STAGING=0
INCLUDE_WWW=1

# ---------- Tenant ----------
# Storefront/admin build'lerine gömülen tenant slug'ı. Seed ile aynı olmalı.
TENANT_SLUG=toptanbudur

# ---------- Watchdog (prod-only, infra/watchdog) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WATCHDOG_INTERVAL_MS=60000
WATCHDOG_TIMEOUT_MS=15000
WATCHDOG_FAIL_THRESHOLD=2
WATCHDOG_NOTIFY_RECOVERY=0
