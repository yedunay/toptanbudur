# ==================================================================
# DEV TEMPLATE — root /.env (SADECE compose okur)
# ==================================================================
# Frontend / admin / backend buradaki değerleri görmez —
# her uygulamanın kendi .env dosyası var.
#
# Tam kurulum:
#   cp .env.dev.example .env                              # compose-only
#   cp apps/backend/.env.dev.example   apps/backend/.env      # backend secrets
#   cp apps/frontend/.env.example  apps/frontend/.env.local
#   cp apps/admin/.env.example     apps/admin/.env
#
# Secret üret:  openssl rand -hex 32
# Token üret:   node -e "console.log(require('crypto').randomUUID())"
# ==================================================================

# ---------- Compose ----------
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# ---------- Postgres (compose container init) ----------
# Backend `apps/backend/.env`'sindeki DATABASE_URL bu user/password ile
# eşleşmeli (compose Postgres'i bu credential'larla bootstrap eder).
POSTGRES_USER=tb
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=tb_b2b

# ---------- MinIO (compose container init) ----------
MINIO_ROOT_USER=tbminio
MINIO_ROOT_PASSWORD=change-me-strong-password
