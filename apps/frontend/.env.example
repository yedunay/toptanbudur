# ==================================================================
# FRONTEND (Next.js storefront) — TEMPLATE
# ==================================================================
#   cp apps/frontend/.env.example apps/frontend/.env.local
# Prod'da localhost URL'lerini https://toptanbudur.com ile değiştir.
# ==================================================================

# SSR fetch'leri — backend container hostname (compose içinde) veya localhost
INTERNAL_API_BASE=http://localhost:4000/api
# Prod: INTERNAL_API_BASE=http://backend:4000/api  (docker network adı)
# SSR auth kontrolü için doğrudan backend kökü (nginx'i baypas eder)
TB_API_BASE=http://localhost:4000

# Browser fetch'leri (NEXT_PUBLIC_*)
NEXT_PUBLIC_API_BASE=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_LOGIN_URL=http://localhost:3002/login
NEXT_PUBLIC_TENANT_SLUG=toptanbudur
# Prod örnekleri:
#   NEXT_PUBLIC_API_BASE=/api
#   NEXT_PUBLIC_API_URL=https://toptanbudur.com
#   NEXT_PUBLIC_STOREFRONT_URL=https://toptanbudur.com
#   NEXT_PUBLIC_ADMIN_URL=https://toptanbudur.com/admin
#   NEXT_PUBLIC_ADMIN_LOGIN_URL=https://toptanbudur.com/admin/login

NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_PHONE_E164=
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=
NEXT_PUBLIC_CONTACT_EMAIL=

# XML feed public base URL (SSR-only, tarayıcıya gitmez)
# Dev: boş bırak — NEXT_PUBLIC_API_URL'den otomatik türetilir
# Prod: https://toptanbudur.com (reverse proxy backend'e yönlendirir)
# XML_PUBLIC_BASE_URL=https://toptanbudur.com
