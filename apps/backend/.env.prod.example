# ==================================================================
# BACKEND (NestJS) — PROD TEMPLATE
# ==================================================================
# Sunucuda:
#   cp apps/backend/.env.prod.example apps/backend/.env
# Sonra secret'ları üret:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomUUID())"
#
# Bu dosya docker-compose.prod.yml'de `env_file: apps/backend/.env` ile
# backend container'a yüklenir. Postgres external; DATABASE_URL uzak host'a
# işaret etmeli.
# ==================================================================

# NODE_ENV / PORT / LOG_LEVEL / REDIS_* / CORS_ORIGINS / STORAGE_PUBLIC_BASE_URL:
# docker-compose.prod.yml'de DOMAIN'e göre override ediliyor — burada YAZMA.

# Admin OTP (giriş 2FA) politikası
#   required : OTP herkes için zorunlu (production'da öneriliyor)
#   optional : Her kullanıcı kendi açıp kapatabilir
#   disabled : OTP herkes için kapalı (production'da önerilmez)
OTP_MODE=disabled

# Postgres (uzak sunucu)
DATABASE_URL=postgresql://tb:GERÇEK_ŞİFRE@10.0.0.5:5432/tb_b2b?schema=public&sslmode=require

# Tokens — openssl rand -hex 32 (DEV'den FARKLI değerler kullan)
JWT_SECRET=
JWT_REFRESH_SECRET=
ORDER_TOKEN_SECRET=
VAULT_MASTER_KEY=
PASSWORD_VAULT_KEY=

# Müşteri iletişim
COMPANY_EMAIL=info@toptanbudur.com
COMPANY_WHATSAPP=

# Storage — Cloudflare R2
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# Custom domain bağlıysa (örn. cdn.toptanbudur.com) buraya yaz; boşsa
# upload() 7 günlük presigned URL döner (yine çalışır).
R2_PUBLIC_URL=

# SMTP — kurumsal e-posta
SMTP_HOST=mail.kurumsaleposta.com
SMTP_PORT=465
SMTP_DONOTREPLY_USER=donotreply@toptanbudur.com
SMTP_DONOTREPLY_PASS=
SMTP_DONOTREPLY_FROM_NAME=Toptan Budur
SMTP_INFO_USER=info@toptanbudur.com
SMTP_INFO_PASS=
SMTP_INFO_FROM_NAME=Toptan Budur

# BirFatura
# NOT: Fatura bekleme süresi ve POS komisyon oranı admin panel
# "Ayarlar → Değişkenler" sayfasından yönetilir.
BIRFATURA_API_TOKEN=
BIRFATURA_TOKEN_HEADER=token
BIRFATURA_SALES_CHANNEL=toptanbudur.com
BIRFATURA_DEFAULT_TC=11111111111

# --- Basit Kargo (kargo entegratörü) ---
BASITKARGO_BASE_URL=https://basitkargo.com/api
BASITKARGO_API_TOKEN=
BASITKARGO_WEBHOOK_TOKEN=

# --- PayTR Sanal POS (iFrame API) ---
# API bilgileri normalde admin POS sayfasından (AES-256-GCM şifreli DB'ye)
# girilir; bu env'ler yalnızca fallback/mirror'dır.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Kart ödeme dönüş sayfalarının açılacağı bayi paneli kök URL'i
# (merchant_ok_url / merchant_fail_url buradan türetilir).
STOREFRONT_URL=https://toptanbudur.com

# --- Seed ---
# `pnpm seed` ile oluşturulan OWNER kullanıcısının parolası.
SEED_ADMIN_PASSWORD=
