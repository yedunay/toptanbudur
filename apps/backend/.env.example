# ==================================================================
# BACKEND (NestJS) — TAM REFERANS
# ==================================================================
# Ortama özel hazır şablonlar: .env.dev.example / .env.prod.example
# Bu dosya, kodun okuduğu TÜM anahtarların referans listesidir.
# ==================================================================

DATABASE_URL="postgresql://USER:PASS@localhost:5432/tb_b2b?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=replace-with-32-byte-hex
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-32-byte-hex
JWT_REFRESH_EXPIRES_IN=30d
ORDER_TOKEN_SECRET=replace-with-32-byte-hex

VAULT_MASTER_KEY=replace-with-32-byte-hex
PASSWORD_VAULT_KEY=replace-with-32-byte-hex

PORT=4000
NODE_ENV=development

# Admin OTP (giriş 2FA) politikası: required | optional | disabled
OTP_MODE=disabled

# --- SMTP (kurumsal e-posta) ---
# Sunucu bilgileri her iki hesap için ortaktır.
SMTP_HOST=mail.kurumsaleposta.com
SMTP_PORT=465

# donotreply hesabı — sistem/transaksiyonel e-postalar (sipariş onayı, cari, vb.)
SMTP_DONOTREPLY_USER=donotreply@toptanbudur.com
SMTP_DONOTREPLY_PASS=
SMTP_DONOTREPLY_FROM_NAME=Toptan Budur

# info hesabı — destek/insan yanıtları (support reply gibi)
SMTP_INFO_USER=info@toptanbudur.com
SMTP_INFO_PASS=
SMTP_INFO_FROM_NAME=Toptan Budur

# DKIM imzalama (spam'a düşmeyi engeller). Boşsa mailler imzasız gider.
# Private key PEM'in base64'ü (tek satır). Public key DNS'e eklenmeli:
#   <SELECTOR>._domainkey.<DOMAIN>  TXT  "v=DKIM1; k=rsa; p=<public_key>"
SMTP_DKIM_PRIVATE_KEY_B64=
SMTP_DKIM_SELECTOR=s1
SMTP_DKIM_DOMAIN=toptanbudur.com

# --- Firma kimliği (e-posta şablonları) ---
# Boş bırakılırsa varsayılanlar kullanılır (Toptan Budur / https://toptanbudur.com).
COMPANY_NAME=Toptan Budur
COMPANY_URL=https://toptanbudur.com
# Boşsa ${COMPANY_URL}/logo.png kullanılır.
COMPANY_LOGO_URL=

# --- Müşteri iletişim ---
COMPANY_EMAIL=info@toptanbudur.com
COMPANY_WHATSAPP=
# Bayi onay e-postasındaki WhatsApp topluluk davet linki. Boşsa blok gösterilmez.
COMPANY_WHATSAPP_COMMUNITY_URL=

# --- Ortak Finans API erişimi ---
# `eposta=FinancePartner.name` çiftleri, `;` ile ayrılır. Boşsa hiçbir admin
# kullanıcı ortak finans API anahtarı üretemez (güvenli varsayılan).
PARTNER_FINANCE_EMAIL_MAP=

# --- Müşteri oturum çerezi ---
# Boşsa prod'da `.toptanbudur.com`, dev'de `localhost` kullanılır.
# Çerez adı sabittir: tb_session
SESSION_COOKIE_DOMAIN=

# --- Günlük Z raporu ---
# Her gece 00:00 (Europe/Istanbul) dünün iş özetini OWNER/ADMIN'lere mailler.
# Z_REPORT_ENABLED=false → zamanlayıcı kapalı (manuel tetikleme yine çalışır).
Z_REPORT_ENABLED=true
# 6 alanlı cron (sn dk saat gün ay haftagünü) — Europe/Istanbul yorumlanır.
Z_REPORT_CRON=0 0 0 * * *
# OWNER/ADMIN dışı ek alıcılar — virgülle ayrılır (opsiyonel).
Z_REPORT_EXTRA_RECIPIENTS=

# --- Storage ---
# STORAGE_DRIVER=local → dosyalar LOCAL_STORAGE_ROOT altına yazılır.
# STORAGE_DRIVER=r2    → Cloudflare R2 (aşağıdaki R2_* alanları zorunlu).
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- BirFatura ---
BIRFATURA_API_TOKEN=
BIRFATURA_TOKEN_HEADER=token
BIRFATURA_SALES_CHANNEL=toptanbudur.com
BIRFATURA_DEFAULT_TC=11111111111

# --- XML Feed ---
XML_FEED_PART_COUNT=5

# --- Basit Kargo (kargo entegratörü) ---
# Tek entegrasyonla Aras/MNG/Yurtiçi/Sürat/PTT. Token .env'de (asla hardcode).
# handler stratejisi / paket ölçüsü / enabled → AppSetting (Değişkenler ekranı).
BASITKARGO_BASE_URL=https://basitkargo.com/api
BASITKARGO_API_TOKEN=
# Webhook URL'ine ?k=<token> olarak eklenir; timingSafeEqual ile doğrulanır.
# Uzun, rastgele bir dize girin. Panelde webhook URL:
#   https://<host>/api/basitkargo/webhook?k=<BASITKARGO_WEBHOOK_TOKEN>
BASITKARGO_WEBHOOK_TOKEN=

# --- PayTR Sanal POS (iFrame API) ---
# API bilgileri normalde admin POS sayfasından (AES-256-GCM şifreli DB'ye)
# girilir; bu env'ler yalnızca fallback/mirror'dır.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Kart ödeme dönüş sayfalarının açılacağı bayi paneli kök URL'i
# (merchant_ok_url / merchant_fail_url buradan türetilir).
STOREFRONT_URL=http://localhost:3001

# --- Ürün eşleştirme AI desteği (opsiyonel) ---
# Boşsa AI geçişi NO-OP; yalnız deterministik (EAN + isim) motor çalışır.
ANTHROPIC_API_KEY=
PRODUCT_MATCH_AI_MODEL=claude-haiku-4-5
PRODUCT_MATCH_AI_MAX_BUCKETS=300

# --- Seed ---
# `pnpm seed` ile oluşturulan OWNER kullanıcısının parolası.
SEED_ADMIN_PASSWORD=
