# ==================================================================
# BACKEND (NestJS) — DEV TEMPLATE
# ==================================================================
#   cp apps/backend/.env.dev.example apps/backend/.env
# Sonra secret'ları üret:
#   openssl rand -hex 32                              # JWT_SECRET vb.
#   node -e "console.log(require('crypto').randomUUID())"  # BIRFATURA_API_TOKEN
# ==================================================================

PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Admin OTP (giriş 2FA) politikası
#   required : OTP herkes için zorunlu (default — production'da bu öneriliyor)
#   optional : Her kullanıcı kendi hesap ayarlarından açıp kapatabilir
#   disabled : OTP herkes için kapalı (dev'de hızlı login için kullanışlı)
OTP_MODE=disabled

# Postgres + Redis
# Native pnpm dev: localhost:5432 (compose'un postgres container'ı)
# Compose container: @postgres:5432 olarak override edilir docker-compose.dev.yml'de
# DATABASE_URL'in user/password kısmı root /.env'deki POSTGRES_USER/PASSWORD ile
# SENKRON olmalı (compose postgres container'ını o credential'larla başlatır).
DATABASE_URL=postgresql://tb:change-me-strong-password@localhost:5432/tb_b2b?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379

# Tokens — openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
ORDER_TOKEN_SECRET=
VAULT_MASTER_KEY=
PASSWORD_VAULT_KEY=

# CORS — dev'de localhost portları
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Müşteri iletişim
COMPANY_EMAIL=info@toptanbudur.com
COMPANY_WHATSAPP=

# Storage — dev'de local disk (apps/backend/uploads). R2 kullanmak için
# STORAGE_DRIVER=r2 yapıp R2_* alanlarını doldurun.
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# SMTP — boş bırakılırsa mail gönderimi log-only fallback'e düşer
SMTP_HOST=mail.kurumsaleposta.com
SMTP_PORT=465
SMTP_DONOTREPLY_USER=donotreply@toptanbudur.com
SMTP_DONOTREPLY_PASS=
SMTP_DONOTREPLY_FROM_NAME=Toptan Budur
SMTP_INFO_USER=info@toptanbudur.com
SMTP_INFO_PASS=
SMTP_INFO_FROM_NAME=Toptan Budur

# BirFatura
# NOT: Fatura bekleme süresi (saat) ve POS komisyon oranı admin panel
# "Ayarlar → Değişkenler" sayfasından (AppSetting) yönetilir, .env'de değil.
BIRFATURA_API_TOKEN=
BIRFATURA_TOKEN_HEADER=token
BIRFATURA_SALES_CHANNEL=toptanbudur.com
BIRFATURA_DEFAULT_TC=11111111111

# XML Feed
XML_FEED_PART_COUNT=5  # Kaç parçaya bölünsün (default 5)

# --- Basit Kargo (kargo entegratörü) ---
BASITKARGO_BASE_URL=https://basitkargo.com/api
BASITKARGO_API_TOKEN=
BASITKARGO_WEBHOOK_TOKEN=

# --- PayTR Sanal POS (iFrame API) ---
# API bilgileri normalde admin POS sayfasından (AES-256-GCM şifreli DB'ye)
# girilir; bu env'ler yalnızca fallback/mirror'dır.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Kart ödeme dönüş sayfalarının açılacağı bayi paneli kök URL'i
# (merchant_ok_url / merchant_fail_url buradan türetilir).
STOREFRONT_URL=http://localhost:3001

# --- Seed ---
# `pnpm seed` ile oluşturulan OWNER kullanıcısının parolası.
SEED_ADMIN_PASSWORD=
